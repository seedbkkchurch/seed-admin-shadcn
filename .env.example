# Supabase (Database/Storage only — auth is handled by Clerk)
# Project settings > API in your Supabase dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push (เฝ้าเดี่ยว reminder — grill-me follow-up, 2026-08-12). Public
# VAPID key only — pairs with the private key stored as a Supabase Edge
# Function secret (VAPID_PRIVATE_KEY), never in this file.
VITE_VAPID_PUBLIC_KEY=

# Hardcoded super_admin bypass (grill-me 2026-08-15) — the auth.uid() of one
# specific staff account with no lamb_info row. Frontend convenience only
# (see comment in .env); the real security boundary is the same UUID
# hardcoded in the RLS migration rbac_super_admin_hardcoded_bypass.
VITE_SUPER_ADMIN_UID=
